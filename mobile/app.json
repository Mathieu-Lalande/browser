{
  "expo": {
    "name": "Browser",
    "slug": "browser-mobile",
    "version": "0.1.0",
    "scheme": "browser-mobile",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141218",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#141218"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mathieulalande.browser",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": true,
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": [
          "fr",
          "en"
        ],
        "NSCameraUsageDescription": "Browser utilise l’appareil photo uniquement pour scanner le QR code de jumelage de la synchronisation."
      }
    },
    "android": {
      "package": "com.mathieulalande.browser",
      "adaptiveIcon": {
        "backgroundColor": "#141218",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "http"
            },
            {
              "scheme": "https"
            }
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Browser utilise l’appareil photo uniquement pour scanner le QR code de jumelage de la synchronisation.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-updates",
      "expo-dev-client"
    ]
  }
}
