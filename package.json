{
  "name": "browser",
  "productName": "Browser",
  "private": true,
  "version": "0.2.0",
  "description": "Un navigateur desktop rapide, privé et entièrement personnalisable.",
  "author": "Mathieu Lalande",
  "homepage": "https://github.com/Mathieu-Lalande/browser",
  "desktopName": "browser.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mathieu-Lalande/browser.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test",
    "test:server": "npm --prefix server test",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.5",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "uqr": "0.1.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.mathieulalande.browser",
    "productName": "Browser",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": null,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Mathieu Lalande",
      "syncDesktopName": true,
      "synopsis": "Navigateur rapide, privé et personnalisable"
    }
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.1",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0"
  }
}
