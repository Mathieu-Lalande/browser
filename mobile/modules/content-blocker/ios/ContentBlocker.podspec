Pod::Spec.new do |s|
  s.name           = 'ContentBlocker'
  s.version        = '1.0.0'
  s.summary        = 'WKContentRuleList content blocker for react-native-webview (ADR-051).'
  s.description    = 'Compiles the bundled WebKit content blocker lists and attaches them to every react-native-webview.'
  s.license        = 'UNLICENSED'
  s.author         = 'Browser'
  s.homepage       = 'https://github.com/'
  s.platforms      = { :ios => '16.4' }
  s.swift_version  = '5.9'
  s.source         = { git: '' }
  s.static_framework = true

  s.dependency 'ExpoModulesCore'

  s.source_files = '**/*.{h,m,swift}'
  # Generated by scripts/build-blocklists.mjs (postinstall), never committed.
  s.resource_bundles = { 'ContentBlockerLists' => ['Blocklists/*.json'] }
  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
    'SWIFT_COMPILATION_MODE' => 'wholemodule'
  }
end
